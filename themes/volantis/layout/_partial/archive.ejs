<% if (site.posts && site.posts.length > 0) { %>
  <section class="post-list">
    <% 
      // 核心优化 1：使用 Set 来记录已渲染过的文章路径，做到 100% 精准去重
      const renderedPaths = new Set(); 
    %>

    <% if (!page.prev) { %>
      <% if (is_home()) { %>
        
        <% site.pages.each(function(p) { %>
          <% if (p.group === 'magazine' && p.show_on_home) { %>
            <div class="post-wrapper magazine-entry">
              <%- partial('_partial/post', {
                post: p,
                is_index: true,
                index_cover: p.headimg,
                index_title: p.title,
                index_excerpt: p.description || '点击查看所有往期内容'
              }) %>
            </div>
            <% renderedPaths.add(p.path); // 记录已渲染 %>
          <% } %>
        <% }) %>

        <% site.pages.each(function(p) { %>
          <% if (p.pin && p.group !== 'magazine' && !renderedPaths.has(p.path)) { %>
            <% if (!page.group || p.group === page.group) { %>
              <div class='post-wrapper'>
                <%- partial('_partial/post', { post: p }) %>
              </div>
              <% renderedPaths.add(p.path); %>
            <% } %>
          <% } %>
        <% }) %>

        <% site.posts.sort('-date').each(function(p) { %>
          <% if (p.pin && p.group !== 'magazine' && !renderedPaths.has(p.path)) { %>
            <% if (!page.group || p.group === page.group) { %>
              <div class='post-wrapper'>
                <%- partial('_partial/post', { post: p }) %>
              </div>
              <% renderedPaths.add(p.path); %>
            <% } %>
          <% } %>
        <% }) %>

      <% } else { %>
        
        <% if (page.posts && page.posts.length > 0) { %>
          <% page.posts.each(function(p) { %>
            <% if (p.pin && !renderedPaths.has(p.path)) { %>
              <div class='post-wrapper'>
                <%- partial('_partial/post', { post: p }) %>
              </div>
              <% renderedPaths.add(p.path); %>
            <% } %>
          <% }) %>
        <% } %>

      <% } %>
    <% } %>

    <% if (page.posts && page.posts.length > 0) { %>
      <% page.posts.each(function(p) { %>
        <% if (!p.pin && !renderedPaths.has(p.path)) { %>
          <% if (!is_home() || p.group !== 'magazine') { %>
            <div class='post-wrapper'>
              <%- partial('_partial/post', { post: p }) %>
            </div>
            <% renderedPaths.add(p.path); %>
          <% } %>
        <% } %>
      <% }) %>
    <% } %>
  </section>

  <% if (page && page.posts && page.total > 1) { %>
    <br>
    <div class="prev-next">
      <% if (page.prev !== 0) { %>
        <a class="prev" rel="prev" href="<%- url_for(page.prev_link) %>">
          <section class="post prev white-box <%- theme.custom_css.body.effect.join(' ') %>" >
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>&nbsp;<%- __('post.prev_page') %>&nbsp;
          </section>
        </a>
      <% } %>
      
      <p class="current">
        <%= page.current %> / <%= page.total %>
      </p>
      
      <% if (page.next !== 0) { %>
        <a class="next" rel="next" href="<%- url_for(page.next_link) %>">
          <section class="post next white-box <%- theme.custom_css.body.effect.join(' ') %>">
            &nbsp;<%- __('post.next_page') %>&nbsp;<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </section>
        </a>
      <% } %>
    </div>
  <% } %>
<% } %>