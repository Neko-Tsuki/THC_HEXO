<%- partial('_pre') %>
<% 
page.comments = false;
if (!page.robots) {
  page.robots = 'noindex,follow';
}
%>

<div id="l_main" class="<%- page.sidebar == false ? ' no_sidebar' : '' %>">
  <div class='post-wrapper'>
    <article class="post article white-box reveal <%- theme.custom_css.body.effect.join(' ') %>">
      <h2><%- page.title %></h2>
      <%- page.content %>
    </article>
  </div>

  <% 
  // 1. 提取并合并数据源
  const items = [];
  const currentGroup = page.group;

  if (currentGroup) {
    const filterFn = p => p.group === currentGroup && p.layout !== 'list';
    
    // 过滤并压入数组
    site.pages.each(p => { if (filterFn(p)) items.push(p); });
    site.posts.each(p => { if (filterFn(p)) items.push(p); });

    // 2. 全局统一按时间倒序排序
    items.sort((a, b) => new Date(b.date) - new Date(a.date));
  }
  %>

  <% if (items.length > 0) { %>
    <div class="magazine-grid">
      <% items.forEach(function(post){ %>
        <div class="magazine-item">
          <a href="<%- url_for(post.path) %>" class="magazine-link">
            
            <% if (post.headimg) { %>
              <img src="<%- url_for(post.headimg) %>" alt="<%= post.title %>" class="magazine-cover" loading="lazy" />
            <% } else { %>
              <div class="magazine-cover placeholder" aria-label="无封面图"></div>
            <% } %>

            <div class="magazine-info">
              <h3 class="magazine-title"><%= post.title %></h3>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- partial('_partial/side') %>